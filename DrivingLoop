    "def detect_objects(image):\n",
    "\n",
    "    # Resize image for YOLO\n",
    "    img = letterbox(\n",
    "        image,\n",
    "        new_shape=YOLO_IMAGE_SIZE\n",
    "    )[0]\n",
    "\n",
    "    # BGR/RGB + HWC/CHW conversion\n",
    "    img = img[:, :, ::-1].transpose(2, 0, 1)\n",
    "\n",
    "    img = np.ascontiguousarray(img)\n",
    "\n",
    "    # Convert to PyTorch\n",
    "    img = torch.from_numpy(img).to(yolo_device)\n",
    "\n",
    "    img = img.float() / 255.0\n",
    "\n",
    "    if img.ndimension() == 3:\n",
    "        img = img.unsqueeze(0)\n",
    "\n",
    "    # YOLO inference\n",
    "    with torch.no_grad():\n",
    "        prediction = yolo(img)[0]\n",
    "\n",
    "    # NMS\n",
    "    prediction = non_max_suppression(\n",
    "        prediction,\n",
    "        YOLO_CONFIDENCE,\n",
    "        YOLO_IOU_THRESHOLD\n",
    "    )\n",
    "\n",
    "    detections = []\n",
    "\n",
    "    for det in prediction:\n",
    "\n",
    "        if len(det) == 0:\n",
    "            continue\n",
    "\n",
    "        # Convert coordinates back to 224x224 camera image\n",
    "        det[:, :4] = scale_coords(\n",
    "            img.shape[2:],\n",
    "            det[:, :4],\n",
    "            image.shape\n",
    "        ).round()\n",
    "\n",
    "        for *xyxy, conf, cls in det:\n",
    "\n",
    "            confidence = float(conf)\n",
    "            class_id = int(cls)\n",
    "            class_name = yolo.names[class_id]\n",
    "\n",
    "            x1, y1, x2, y2 = [\n",
    "                int(v.item()) for v in xyxy\n",
    "            ]\n",
    "\n",
    "            width = max(0, x2 - x1)\n",
    "            height = max(0, y2 - y1)\n",
    "\n",
    "            area = width * height\n",
    "\n",
    "            # Check class\n",
    "            if TARGET_CLASSES is not None:\n",
    "                if class_name not in TARGET_CLASSES:\n",
    "                    continue\n",
    "\n",
    "            # Ignore tiny detections\n",
    "            if area < MIN_OBJECT_AREA:\n",
    "                continue\n",
    "\n",
    "            detections.append({\n",
    "                'class_name': class_name,\n",
    "                'confidence': confidence,\n",
    "                'area': area\n",
    "            })\n",
    "\n",
    "    return detections\n",
    "\n",
    "\n",
    "\n",
    "def detect_green_tape(image):\n",
    "\n",
    "    hsv = cv2.cvtColor(\n",
    "        image,\n",
    "        cv2.COLOR_RGB2HSV\n",
    "    )\n",
    "\n",
    "    lower = np.array([\n",
    "        GREEN_H_LOW,\n",
    "        GREEN_S_LOW,\n",
    "        GREEN_V_LOW\n",
    "    ])\n",
    "\n",
    "    upper = np.array([\n",
    "        GREEN_H_HIGH,\n",
    "        GREEN_S_HIGH,\n",
    "        GREEN_V_HIGH\n",
    "    ])\n",
    "\n",
    "    mask = cv2.inRange(\n",
    "        hsv,\n",
    "        lower,\n",
    "        upper\n",
    "    )\n",
    "\n",
    "    # Ignore upper image\n",
    "    mask[:GREEN_ROI_TOP, :] = 0\n",
    "\n",
    "    kernel = np.ones((5, 5), np.uint8)\n",
    "\n",
    "    mask = cv2.morphologyEx(\n",
    "        mask,\n",
    "        cv2.MORPH_OPEN,\n",
    "        kernel\n",
    "    )\n",
    "\n",
    "    mask = cv2.morphologyEx(\n",
    "        mask,\n",
    "        cv2.MORPH_CLOSE,\n",
    "        kernel\n",
    "    )\n",
    "\n",
    "    ys, xs = np.where(mask > 0)\n",
    "\n",
    "    pixel_count = len(xs)\n",
    "\n",
    "    if pixel_count < GREEN_MIN_PIXELS:\n",
    "\n",
    "        return {\n",
    "            \"detected\": False,\n",
    "            \"center_x\": None,\n",
    "            \"pixels\": pixel_count\n",
    "        }\n",
    "\n",
    "    center_x = int(np.mean(xs))\n",
    "\n",
    "    return {\n",
    "        \"detected\": True,\n",
    "        \"center_x\": center_x,\n",
    "        \"pixels\": pixel_count\n",
    "    }\n",
    "\n",
    "\n",
    "def detect_blue_finish_line(image):\n",
    "\n",
    "    hsv = cv2.cvtColor(\n",
    "        image,\n",
    "        cv2.COLOR_RGB2HSV\n",
    "    )\n",
    "\n",
    " \n",
    "\n",
    "    lower_blue = np.array([\n",
    "        BLUE_H_LOW,\n",
    "        BLUE_S_LOW,\n",
    "        BLUE_V_LOW\n",
    "    ])\n",
    "\n",
    "    upper_blue = np.array([\n",
    "        BLUE_H_HIGH,\n",
    "        BLUE_S_HIGH,\n",
    "        BLUE_V_HIGH\n",
    "    ])\n",
    "\n",
    "    mask = cv2.inRange(\n",
    "        hsv,\n",
    "        lower_blue,\n",
    "        upper_blue\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "    mask[:BLUE_ROI_TOP, :] = 0\n",
    "\n",
    "\n",
    "\n",
    "    kernel = np.ones((5, 5), np.uint8)\n",
    "\n",
    "    mask = cv2.morphologyEx(\n",
    "        mask,\n",
    "        cv2.MORPH_OPEN,\n",
    "        kernel\n",
    "    )\n",
    "\n",
    "    mask = cv2.morphologyEx(\n",
    "        mask,\n",
    "        cv2.MORPH_CLOSE,\n",
    "        kernel\n",
    "    )\n",
    "\n",
    "  \n",
    "\n",
    "    ys, xs = np.where(mask > 0)\n",
    "\n",
    "    pixel_count = len(xs)\n",
    "\n",
    "  \n",
    "\n",
    "    if pixel_count < BLUE_MIN_PIXELS:\n",
    "\n",
    "        return {\n",
    "            \"detected\": False,\n",
    "            \"center_x\": None,\n",
    "            \"pixels\": pixel_count\n",
    "        }\n",
    "\n",
    "\n",
    "    center_x = int(np.mean(xs))\n",
    "\n",
    "    return {\n",
    "        \"detected\": True,\n",
    "        \"center_x\": center_x,\n",
    "        \"pixels\": pixel_count\n",
    "    }"
