    "def update_tire_health(\n",
    "    steering,\n",
    "    driving_dt\n",
    "):\n",
    "\n",
    "    global tire_fl\n",
    "    global tire_fr\n",
    "    global tire_rl\n",
    "    global tire_rr\n",
    "\n",
    "\n",
    "   \n",
    "\n",
    "    if driving_dt <= 0:\n",
    "\n",
    "        return\n",
    "\n",
    "\n",
    "\n",
    "    if abs(car.throttle) <= 0:\n",
    "\n",
    "        return\n",
    "\n",
    "\n",
    "   \n",
    "\n",
    "    base_wear = (\n",
    "        TIRE_BASE_WEAR_RATE\n",
    "        * driving_dt\n",
    "    )\n",
    "\n",
    "\n",
    "  \n",
    "\n",
    "    steering_amount = abs(\n",
    "        float(steering)\n",
    "    )\n",
    "\n",
    "\n",
    "    steering_wear = (\n",
    "        TIRE_STEERING_WEAR_RATE\n",
    "        * steering_amount\n",
    "        * driving_dt\n",
    "    )\n",
    "\n",
    "\n",
    "  \n",
    "\n",
    "    if steering < 0:\n",
    "\n",
    "        left_wear = (\n",
    "            base_wear\n",
    "            + steering_wear\n",
    "        )\n",
    "\n",
    "\n",
    "        tire_fl -= left_wear\n",
    "        tire_rl -= left_wear\n",
    "\n",
    "        tire_fr -= base_wear\n",
    "        tire_rr -= base_wear\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "    elif steering > 0:\n",
    "\n",
    "        right_wear = (\n",
    "            base_wear\n",
    "            + steering_wear\n",
    "        )\n",
    "\n",
    "\n",
    "        tire_fr -= right_wear\n",
    "        tire_rr -= right_wear\n",
    "\n",
    "        tire_fl -= base_wear\n",
    "        tire_rl -= base_wear\n",
    "\n",
    "\n",
    "   \n",
    "\n",
    "    else:\n",
    "\n",
    "        tire_fl -= base_wear\n",
    "        tire_fr -= base_wear\n",
    "        tire_rl -= base_wear\n",
    "        tire_rr -= base_wear\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "    tire_fl = max(\n",
    "        0.0,\n",
    "        min(\n",
    "            1.0,\n",
    "            tire_fl\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    tire_fr = max(\n",
    "        0.0,\n",
    "        min(\n",
    "            1.0,\n",
    "            tire_fr\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    tire_rl = max(\n",
    "        0.0,\n",
    "        min(\n",
    "            1.0,\n",
    "            tire_rl\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    tire_rr = max(\n",
