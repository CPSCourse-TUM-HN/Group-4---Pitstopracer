    "                ):\n",
    "\n",
    "                    car.throttle = 0.0\n",
    "                    car.steering = 0.0\n",
    "\n",
    "                    print(\n",
    "                        \"\\n🟢 GREEN CONFIRMED \"\n",
    "                        f\"({green_duration:.2f}s)\"\n",
    "                    )\n",
    "\n",
    "                    print(\n",
    "                        \"🅿️ PIT STOP → CHARGING\"\n",
    "                    )\n",
    "\n",
    "                    green_stop = True\n",
    "\n",
    "                    is_charging = True\n",
    "\n",
    "                    current_mode = \"charging\"\n",
    "\n",
    "                    continue\n",
    "\n",
    "\n",
    "            else:\n",
    "\n",
    "               \n",
    "\n",
    "                if green_start_time is not None:\n",
    "\n",
    "                    print(\n",
    "                        \"\\n🟢 Green lost \"\n",
    "                        \"→ confirmation reset.\"\n",
    "                    )\n",
    "\n",
    "                green_start_time = None\n",
    "\n",
    "\n",
    "        else:\n",
    "\n",
    "         \n",
    "\n",
    "            green_start_time = None\n",
    "\n",
    "\n",
    "      \n",
    "\n",
    "        processed = preprocess(\n",
    "            image\n",
    "        ).half()\n",
    "\n",
    "\n",
    "        output = (\n",
    "            model_trt(processed)\n",
    "            .detach()\n",
    "            .cpu()\n",
    "            .numpy()\n",
    "            .flatten()\n",
    "        )\n",
    "\n",
    "\n",
    "        x = float(\n",
    "            output[0]\n",
    "        )\n",
    "\n",
    "\n",
    "        steering = (\n",
    "            x\n",
    "            * STEERING_GAIN\n",
    "            + STEERING_BIAS\n",
    "        )\n",
    "\n",
    "\n",
    "        steering = max(\n",
    "            -1.0,\n",
    "            min(\n",
    "                1.0,\n",
    "                steering\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            abs(x)\n",
    "            > DETECTION_THRESHOLD\n",
    "        ):\n",
    "\n",
    "            last_steering = steering\n",
    "\n",
    "        else:\n",
    "\n",
    "            steering = last_steering\n",
    "\n",
    "\n",
    "     \n",
    "\n",
    "        if rain_enabled:\n",
    "\n",
    "            current_mode = \"raining\"\n",
    "\n",
    "            actual_throttle = RAIN_THROTTLE\n",
    "\n",
    "\n",
    "        elif pit_needed:\n",
    "\n",
    "           \n",
    "\n",
    "            current_mode = \"pitstop\"\n",
    "\n",
    "            actual_throttle = CAR_THROTTLE\n",
    "\n",
    "\n",
    "        else:\n",
    "\n",
    "            current_mode = \"driving\"\n",
    "\n",
    "            actual_throttle = CAR_THROTTLE\n",
    "\n",
    "\n",
    "      \n",
    "\n",
    "        car.steering = steering\n",
    "\n",
    "        car.throttle = actual_throttle\n",
    "\n",
    "\n",
    "       \n",
    "\n",
    "        lap_time = (\n",
    "            current_time\n",
    "            - race_start_time\n",
    "        )\n",
    "\n",
    "\n",
    "        estimated_speed = (\n",
    "            abs(actual_throttle)\n",
    "            / CAR_THROTTLE\n",
    "        ) * ESTIMATED_MAX_SPEED\n",
    "\n",
    "\n",
    "        publish_state_telemetry(\n",
    "            speed=estimated_speed,\n",
    "            steering=steering,\n",
    "            throttle=actual_throttle,\n",
    "            lap=current_lap,\n",
    "            lap_time=lap_time,\n",
    "            mode=current_mode\n",
    "        )\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "except KeyboardInterrupt:\n",
    "\n",
    "    print(\n",
    "        \"\\nKeyboard interrupt.\"\n",
    "    )\n",
    "\n",
    "\n",
    "except Exception as e:\n",
    "\n",
    "    print(\n",
    "        \"\\nError:\",\n",
    "        e\n",
    "    )\n",
    "\n",
    "\n",
    "finally:\n",
    "\n",
    "    car.throttle = 0.0\n",
    "    car.steering = 0.0\n",
    "\n",
    "\n",
    "   \n",
    "\n",
    "    try:\n",
    "\n",
    "        publish_state_telemetry(\n",
    "            speed=0.0,\n",
    "            steering=0.0,\n",
    "            throttle=0.0,\n",
    "            lap=current_lap,\n",
    "            lap_time=(\n",
    "                time.time()\n",
    "                - race_start_time\n",
    "            ),\n",
    "            mode=\"pitstop\"\n",
    "        )\n",
    "\n",
    "\n",
    "        publish_fuel_telemetry(\n",
    "            fuel\n",
    "        )\n",
    "\n",
    "\n",
    "        publish_tire_telemetry()\n",
    "\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        pass\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n================================\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"CAR SAFELY STOPPED\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"FINAL LAP: {current_lap}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"================================\"\n",
    "    )"
   ]
